generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Category {
  id           String    @id @default(cuid())
  name         String    @unique  // "News", "Sports", etc.
  slug         String    @unique  // "news", "sports", etc.
  displayOrder Int       @default(0)
  
  articles     Article[]
  
  @@map("categories")
}

model Edition {
  id        String    @id @default(cuid())
  date      String    @unique  // "1986-10-17"
  pageCount Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  articles  Article[]
}

model Article {
  id           String   @id @default(cuid())
  edition      Edition  @relation(fields: [editionDate], references: [date])
  editionDate  String
  headline     String
  summary      String?
  fullText     String
  
  // Category relation (FK constraint for data integrity)
  categoryId   String   @map("category_id")
  category     Category @relation(fields: [categoryId], references: [id])
  
  byline       String?
  page         Int
  imageUrl     String?
  imageCaption String?
  isHero       Boolean  @default(false)
  isFeatured   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([editionDate])
  @@index([categoryId])
}
