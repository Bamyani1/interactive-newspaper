{
  "name": "transcript-archive",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:frontend": "vitest run tests/archive tests/ask-archive tests/components tests/edition-picker tests/footer tests/music tests/news-feed tests/theme tests/time-controls",
    "test:e2e": "playwright test tests/e2e/smoke --project=chromium-desktop --project=chromium-mobile --project=firefox-smoke --project=webkit-smoke",
    "test:e2e:production": "PLAYWRIGHT_SERVER_MODE=production PLAYWRIGHT_PORT=3101 playwright test tests/e2e/smoke/primitives-environment.spec.ts --project=chromium-desktop",
    "audit:visual": "playwright test tests/e2e/audit/visual.spec.ts --project=chromium-desktop --project=chromium-mobile",
    "audit:editions": "PLAYWRIGHT_SERVER_MODE=production PLAYWRIGHT_PORT=3102 playwright test tests/e2e/audit/editions.spec.ts --project=chromium-desktop --project=chromium-mobile",
    "audit:transitions": "playwright test tests/e2e/audit/transitions.spec.ts --project=chromium-desktop --project=chromium-mobile",
    "weather:build:ohio": "node scripts/weather/build-ohio-weather-archive.mjs && npm run weather:verify:ohio",
    "weather:verify:ohio": "node scripts/weather/verify-ohio-weather-archive.mjs",
    "glass:build": "node scripts/dev/generate-stained-glass-svg.mjs",
    "canopy:build": "node scripts/dev/generate-autumn-canopy-svg.mjs",
    "db:seed": "node --import tsx scripts/db/seed.mjs",
    "db:reset": "node --import tsx scripts/db/seed.mjs --reset",
    "db:embed": "node --import tsx scripts/db/embed.mjs",
    "db:migrate": "node --import tsx scripts/db/migrate.mjs",
    "db:migrate:status": "node --import tsx scripts/db/migrate.mjs --status",
    "db:schema:snapshot": "node --import tsx scripts/db/generate-schema-snapshot.mjs",
    "db:backfill:rag-records": "node --import tsx scripts/db/backfill-rag-records.mjs",
    "google:verify-adc": "node --import tsx scripts/google/verify-adc.ts",
    "rag:snapshot-corpus": "node --import tsx scripts/rag/snapshot-corpus.ts",
    "rag:inventory-source": "node --import tsx scripts/iiif/inventory-source.ts",
    "rag:build-freeze-report": "node --import tsx scripts/rag/build-freeze-report.ts",
    "rag:verify-evaluation-freeze": "node --import tsx scripts/rag/verify-evaluation-freeze.ts",
    "rag:run-eval": "node --import tsx scripts/rag/run-eval.ts",
    "rag:score-eval": "node --import tsx scripts/rag/score-eval.ts",
    "rag:export-public-corpus": "node --import tsx scripts/rag/export-public-corpus.ts",
    "rag:setup-eval-db": "node --import tsx scripts/rag/setup-eval-db.mjs",
    "rag:index:build": "node --import tsx scripts/db/build-rag-index.mjs",
    "test:invariants": "vitest run tests/ocr/pipeline-invariants.test.ts",
    "images:upload": "node scripts/db/upload-images.mjs",
    "images:gc": "node scripts/db/gc-r2-assets.mjs",
    "assets:bootstrap": "node --import tsx scripts/db/bootstrap-asset-registry.mjs",
    "test:typecheck": "tsc -p tsconfig.test.json --noEmit",
    "db:publish-edition": "node --import tsx scripts/db/publish-edition.mjs",
    "db:import-build-vectors": "node --import tsx scripts/db/import-build-vectors.mjs",
    "db:export-build-vectors": "node --import tsx scripts/db/export-build-vectors.mjs",
    "db:gc-index-builds": "node --import tsx scripts/db/gc-index-builds.mjs",
    "db:retention-sweep": "node --import tsx scripts/db/retention-sweep.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1030.0",
    "@google/genai": "2.15.0",
    "@neondatabase/serverless": "^1.0.2",
    "@vercel/analytics": "^2.0.1",
    "framer-motion": "12.42.2",
    "google-auth-library": "10.5.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.556.0",
    "next": "16.2.12",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sanitize-html": "2.17.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@electric-sql/pglite": "0.5.4",
    "@electric-sql/pglite-pgvector": "0.0.5",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.3.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "jsdom": "^24.0.0",
    "oslllo-potrace": "^5.0.0",
    "p-limit": "^7.3.0",
    "pg": "^8.22.0",
    "sharp": "^0.34.5",
    "tailwindcss": "4.3.2",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "3.2.7",
    "youtubei.js": "^17.0.1"
  }
}
