# ===========================================
# API Keys (REQUIRED)
# ===========================================

# Gemini API Key — used for OCR pipeline, article embedding (RAG), and Ask the Archive
# Get one at: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Google Cloud Vision API credentials file path
# Download from Google Cloud Console > APIs & Services > Credentials
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your-credentials.json

# ===========================================
# Database Configuration
# ===========================================

# SQLite (development)
DATABASE_URL="file:./prisma/dev.db"

# PostgreSQL (production - uncomment to use)
# DATABASE_URL="postgresql://user:password@localhost:5432/transcript_archive?schema=public"
