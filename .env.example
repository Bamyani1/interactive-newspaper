# ===========================================
# Database (REQUIRED)
# ===========================================

# Neon Postgres connection string
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/dbname?sslmode=require

# ===========================================
# Google AI via Vertex ADC (REQUIRED)
# ===========================================

# Authenticate locally with: gcloud auth application-default login
# In production, attach a service account with the required Vertex AI role.
GOOGLE_CLOUD_PROJECT=your_project_id
GOOGLE_CLOUD_LOCATION=global
# --- Serving auth (Vercel) ---
# Vercel has no ADC. Set GOOGLE_CLOUD_PROJECT there too, plus the service-account
# key below (raw JSON or base64 of it). Leave it unset locally when you use ADC.
# GOOGLE_SERVICE_ACCOUNT_JSON=base64_or_raw_service_account_json
# There is no API-key mode: without GOOGLE_CLOUD_PROJECT every Gemini client
# refuses to start. Don't set GEMINI_API_KEY or GOOGLE_API_KEY.
# Optional local safety assertion used by `npm run google:verify-adc`.
# GOOGLE_ADC_EXPECTED_PRINCIPAL=you@example.com
# Serving reads one activated, immutable index build. `npm run rag:index:build`
# prints both values when it activates a build; `npm run rag:health` checks them.
# Legacy mode matches no vectors and silently runs keyword-only, so don't use it.
RAG_RETRIEVAL_MODE=versioned
RAG_ACTIVE_INDEX_BUILD_ID=rag-index-build-id
RAG_CORPUS_VERSION=corpus-version-from-the-build

# Document AI is used only by OCR.
DOCUMENT_AI_PROCESSOR_ID=your_processor_id
DOCUMENT_AI_LOCATION=us

# Set true only after reviewing and accepting both detector licenses described
# in ocr/README.md.
OCR_DETECTOR_LICENSES_ACCEPTED=false

# ===========================================
# Cloudflare R2 (optional — image hosting)
# ===========================================

# R2_ACCOUNT_ID=your_account_id
# R2_ACCESS_KEY_ID=your_access_key_id
# R2_SECRET_ACCESS_KEY=your_secret_access_key
# R2_BUCKET_NAME=your_bucket_name

# Public CDN base URL for edition images (optional; R2 in prod, local proxy otherwise)
# IMAGE_BASE_URL=https://pub-<hash>.r2.dev

# ===========================================
# Optional runtime tokens & tuning
# ===========================================

# Bearer token the Vercel cron presents to /api/internal/retention (required in prod).
# CRON_SECRET=your_cron_secret
# Auth token for POST /api/admin/revalidate.
# ADMIN_REVALIDATE_TOKEN=your_admin_token
# Enables the Voyage cross-encoder reranker; falls back to Gemini reranking when unset.
# VOYAGE_API_KEY=your_voyage_api_key
# Daily AI spend cap per environment, in USD (default 2, clamped to 50).
# RAG_DAILY_BUDGET_USD=2
# Days to keep Ask conversation turns before the retention sweep (default 7).
# ASK_SESSION_TTL_DAYS=7
